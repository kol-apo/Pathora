# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# ── Database ────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (Atlas → Connect → Drivers).
# Include the database name in the path, before the query string.
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/pathora?retryWrites=true&w=majority"

# ── Sign-in (Auth.js) ───────────────────────────────────────────────────────
# Signs the session cookie. Required. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Optional: "Continue with Google". Leave empty to offer email and password only.
# Create them in Google Cloud Console > Google Auth Platform > Clients, with the
# redirect URI http://localhost:3000/api/auth/callback/google (and your
# deployed origin's equivalent in production).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── AI discovery agent ──────────────────────────────────────────────────────
# "mock"              — offline, deterministic, no key. The default.
# "openai-compatible" — anything speaking the OpenAI /chat/completions shape.
AI_PROVIDER="mock"

# Only needed when AI_PROVIDER="openai-compatible". Base URL stops before
# /chat/completions.
#
# Gemini (free tier, key from aistudio.google.com/apikey):
#   AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
#   AI_MODEL="gemini-3.5-flash-lite"
#   AI_TIMEOUT_MS="45000"
# gemini-3.5-flash-lite answers in about 6-12 seconds. The newest Flash models
# are often "experiencing high demand" (HTTP 503) on the free tier.
# On the free tier Google may use prompts and responses to improve its
# products, and human reviewers may read them. Use it with test accounts, not
# real study participants, unless the consent form says so.
#
# Other examples:
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama      http://localhost:11434/v1
AI_BASE_URL=""
AI_MODEL=""
AI_API_KEY=""

# Optional. Request timeout, and whether to send response_format=json_object
# (set false for the few services that reject the field).
AI_TIMEOUT_MS="30000"
AI_JSON_MODE="true"

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Password-reset emails. Free tier: 3,000 a month, 100 a day. Without a key,
# emails are printed in the terminal during development instead of sent.
# Until a domain is verified at resend.com/domains, only
# "Pathora <onboarding@resend.dev>" works, and it delivers only to the email
# address of your own Resend account.
RESEND_API_KEY=""
EMAIL_FROM="Pathora <onboarding@resend.dev>"

# The site's address, for links in emails. Required once deployed (on Vercel
# the production domain is used if this is empty).
APP_URL=""

# ── Opportunities ───────────────────────────────────────────────────────────
# Only once deployed: a scheduler (Vercel Cron) sends this as a Bearer token to
# /api/cron/opportunities to read the opportunity feeds. Any long random string.
CRON_SECRET=""

# ── Video (Daily) ───────────────────────────────────────────────────────────
# From dashboard.daily.co, Developers page. Server-side only: never exposed to
# the browser. Daily needs a payment method on the account before calls work,
# even on the free tier (10,000 minutes a month).
DAILY_API_KEY=""
